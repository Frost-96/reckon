{
  "name": "reckon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "docker compose --profile dev up --build",
    "experiment": "docker compose --profile experiment up --build --detach --wait",
    "scenario": "node apps/evaluator/src/main.ts",
    "db:up": "docker compose up --detach --wait postgres",
    "db:migrate": "pnpm db:up && pnpm --filter @reckon/business-mock db:migrate && pnpm --filter @reckon/kernel db:migrate",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm db:up && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
